# Copy to .env and fill in. NEVER commit .env.

# ---- CockroachDB ----
# From CockroachDB Cloud: Connect -> "General connection string".
# psycopg needs the sslrootcert path on Windows if sslmode=verify-full.
CRDB_URL=postgresql://<user>:<password>@<host>:26257/defaultdb?sslmode=verify-full
CRDB_URL_AUDITOR=postgresql://auditor@...      # read-only role, used by the MCP auditor
CRDB_APP_NAME=quorum
QUORUM_DB=quorum                        # database the migration creates and the app uses

# ---- AWS / Bedrock (OPTIONAL) ----
# Without credentials the system uses deterministic offline providers and
# records that fact in every run report. Nothing silently degrades.
AWS_REGION=us-east-1
BEDROCK_EMBED_MODEL_ID=amazon.titan-embed-text-v2:0
BEDROCK_EMBED_DIM=1024
BEDROCK_CHAT_MODEL_ID=                # confirm what is enabled in YOUR region
S3_BUCKET=quorum-runs-<suffix>

# ---- Quorum tuning ----
ANN_K=8
TAU_ADJUDICATE=0.82
ADJUDICATE_BUDGET=3
EVIDENCE_MARGIN=2
CONF_EPSILON=0.05
TXN_MAX_RETRIES=8
TXN_SLOW_MS=100
REPREPARE_MAX=2
RUN_SEED=1337

# Tier-2 global ceiling per run
ADJUDICATE_RUN_CEILING=200

# Copy to .env and fill in. NEVER commit .env.

# ---- CockroachDB ----
# From CockroachDB Cloud: Connect -> "General connection string".
# psycopg needs the sslrootcert path on Windows if sslmode=verify-full.
CRDB_URL=
# Read-only role, used by the MCP auditor
CRDB_URL_AUDITOR=
CRDB_APP_NAME=quorum
QUORUM_DB=quorum                        # database the migration creates and the app uses

# ---- AWS / Bedrock (OPTIONAL) ----
# Bedrock auth, pick ONE:
#   * classic IAM keys: AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY
#   * or a Bedrock API key from the console: AWS_BEARER_TOKEN_BEDROCK
# Do NOT leave AWS_BEARER_TOKEN_BEDROCK present-but-blank. botocore switches to
# bearer auth on the variable EXISTING, so a blank one makes every call fail
# with IncompleteSignatureException while good IAM keys sit unused. Omit the
# line entirely if unused (quorum.db.pool strips a blank one defensively).
# Without credentials the system uses deterministic offline providers and
# records that fact in every run report. Nothing silently degrades.
AWS_REGION=us-east-1
BEDROCK_EMBED_MODEL_ID=amazon.titan-embed-text-v2:0
BEDROCK_EMBED_DIM=1024
# Confirm the exact id for YOUR region:
#   aws bedrock list-foundation-models --region $AWS_REGION
BEDROCK_CHAT_MODEL_ID=
S3_BUCKET=

# ---- Quorum tuning ----
ANN_K=8
TAU_ADJUDICATE=0.82
ADJUDICATE_BUDGET=3
EVIDENCE_MARGIN=2
CONF_EPSILON=0.05
TXN_MAX_RETRIES=8
TXN_SLOW_MS=100
REPREPARE_MAX=2
RUN_SEED=1337

# Tier-2 global ceiling per run
ADJUDICATE_RUN_CEILING=200
